# Backend
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000

# Agora.io (Phase 4 video)
# App ID is public; never put AGORA_APP_CERTIFICATE in the frontend bundle.
# Never create VITE_* variables for certificates, private keys, webhook secrets or Stripe secret keys.
# The frontend obtains RTC tokens from POST /api/v1/video/token.
VITE_AGORA_APP_ID=
